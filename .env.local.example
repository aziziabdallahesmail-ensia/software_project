# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres — Project Settings > Database > Connection string
# DATABASE_URL uses the pooler (port 6543, add ?pgbouncer=true)
# DIRECT_URL uses the direct connection (port 5432) and is used for migrations
DATABASE_URL=
DIRECT_URL=

# Twilio Video — optional; the video-call flow is disabled without these
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


generator client {
  provider = "prisma-client-js"
}

// schema.prisma

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")       // Your pooled URL (:6543 with ?pgbouncer=true)
  directUrl = env("DIRECT_URL") // Your unpooled URL (:5432)
}


model User {
  id        String   @id @default(cuid())
  email     String   @unique
}